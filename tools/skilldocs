#!/usr/bin/env python3

"""在 Skill 源码仓库与 Obsidian 之间受控同步 Markdown 文档。"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import tempfile
from pathlib import Path


REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = REPOSITORY_ROOT / "registry" / "skills.json"
STATE_PATH = (Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))).expanduser()
              / "fangzhikun-skills" / "obsidian-docs.json")
CONFIG_PATH = Path(os.environ.get(
    "FANGZHIKUN_SKILLS_CONFIG",
    str(Path.home() / ".config" / "fangzhikun-skills" / "runtime.json"),
)).expanduser()
GLOBAL_PATHS = {"README.md", "CHANGELOG.md"}
OBSIDIAN_RELATIVE_ROOT = Path("03.AI") / "20.skills管理" / "10.文档"


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def read_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise RuntimeError(f"JSON 顶层必须是对象：{path}")
    return value


def write_json_atomic(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temporary_file:
            json.dump(value, temporary_file, ensure_ascii=False, indent=2, sort_keys=True)
            temporary_file.write("\n")
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)


def ensure_no_symlink(path: Path, root: Path) -> None:
    relative = path.relative_to(root)
    current = root
    if current.is_symlink():
        raise RuntimeError(f"不支持软链接目录：{current}")
    for part in relative.parts:
        current /= part
        if current.is_symlink():
            raise RuntimeError(f"不支持软链接文件或目录：{current}")


def document_root(override: str | None) -> Path:
    if override:
        candidate = Path(override).expanduser()
    else:
        config = read_json(CONFIG_PATH)
        manager = config.get("skillManager", {})
        paths = config.get("paths", {})
        if not isinstance(manager, dict) or not isinstance(paths, dict):
            raise RuntimeError("本机 Skill 管理路径配置结构不合法")
        explicit = manager.get("obsidianDocsRoot")
        if explicit is not None:
            if not isinstance(explicit, str) or not explicit:
                raise RuntimeError("skillManager.obsidianDocsRoot 必须是非空绝对路径")
            candidate = Path(explicit).expanduser()
        else:
            vault = paths.get("vault")
            if not isinstance(vault, str) or not vault:
                raise RuntimeError("缺少 obsidianDocsRoot 或 paths.vault；也可传入 --docs-root")
            candidate = Path(vault).expanduser() / OBSIDIAN_RELATIVE_ROOT
    if not candidate.is_absolute():
        raise RuntimeError("Obsidian 文档目录必须是绝对路径")
    root = candidate.resolve()
    if root == REPOSITORY_ROOT or root.is_relative_to(REPOSITORY_ROOT) or REPOSITORY_ROOT.is_relative_to(root):
        raise RuntimeError("Obsidian 文档目录不得与源码仓库嵌套")
    if candidate.is_symlink():
        raise RuntimeError("Obsidian 文档目录不得是软链接")
    return root


def skill_directories() -> dict[str, str]:
    registry = read_json(REGISTRY_PATH)
    if registry.get("schemaVersion") != 1 or not isinstance(registry.get("skills"), dict):
        raise RuntimeError("Skill 注册表结构不合法")
    result = {}
    for name, metadata in registry["skills"].items():
        if metadata.get("ownership") != "first-party":
            continue
        source = metadata.get("source")
        if source != f"skills/{name}":
            raise RuntimeError(f"Skill 源码路径不符合预期：{name}")
        result[name] = source
    return result


def managed(relative_path: str, skill_names: set[str]) -> bool:
    parts = Path(relative_path).parts
    if not parts or Path(relative_path).is_absolute() or ".." in parts or "\\" in relative_path:
        return False
    if Path(relative_path).suffix.lower() != ".md":
        return False
    if relative_path in GLOBAL_PATHS:
        return True
    if len(parts) >= 3 and parts[:2] == ("config", "examples"):
        return True
    return len(parts) >= 3 and parts[0] == "skills" and parts[1] in skill_names


def scan(root: Path, skill_names: set[str]) -> set[str]:
    if not root.exists():
        return set()
    if not root.is_dir():
        raise RuntimeError(f"文档根路径不是目录：{root}")
    found = set()
    for path in root.rglob("*.md"):
        ensure_no_symlink(path, root)
        if not path.is_file():
            continue
        relative = path.relative_to(root).as_posix()
        if managed(relative, skill_names):
            found.add(relative)
    return found


def read_document(root: Path, relative: str) -> bytes | None:
    path = root / relative
    ensure_no_symlink(path, root)
    if not path.exists():
        return None
    if not path.is_file():
        raise RuntimeError(f"文档路径不是文件：{path}")
    return path.read_bytes()


def write_document(root: Path, relative: str, content: bytes, expected: bytes | None) -> None:
    path = root / relative
    ensure_no_symlink(path, root)
    current = read_document(root, relative)
    if current != expected:
        raise RuntimeError(f"写入前内容发生变化，已停止：{relative}")
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as temporary_file:
            temporary_file.write(content)
        os.replace(temporary_name, path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)
    if read_document(root, relative) != content:
        raise RuntimeError(f"写入后哈希核对失败：{relative}")


def classify(repository: bytes | None, obsidian: bytes | None, baseline: str | None,
             allow_new_vault_file: bool) -> str:
    repository_hash = digest(repository) if repository is not None else None
    obsidian_hash = digest(obsidian) if obsidian is not None else None
    if repository_hash is not None and repository_hash == obsidian_hash:
        return "一致"
    if baseline is None:
        if repository is None:
            return "Obsidian → 仓库" if allow_new_vault_file else "冲突：Obsidian 新文档需显式审阅"
        if obsidian is None:
            return "仓库 → Obsidian"
        return "冲突"
    if repository is None or obsidian is None:
        return "冲突：文件缺失或删除"
    if repository_hash == baseline:
        return "Obsidian → 仓库"
    if obsidian_hash == baseline:
        return "仓库 → Obsidian"
    return "冲突"


def selected(relative: str, skill: str | None) -> bool:
    return skill is None or relative == "CHANGELOG.md" or relative.startswith(f"skills/{skill}/")


def main() -> int:
    parser = argparse.ArgumentParser(description="受控同步 Skill Markdown 与 Obsidian 文档")
    parser.add_argument("command", choices=("status", "sync", "check"))
    parser.add_argument("--skill", help="仅处理指定 Skill 文档和 CHANGELOG.md")
    parser.add_argument("--docs-root", help="覆盖本机配置中的 Obsidian 文档目录")
    parser.add_argument("--apply", action="store_true", help="仅 sync 可用；应用预览中的安全变更")
    parser.add_argument("--import-new", action="append", default=[], metavar="相对路径",
                        help="显式允许从 Obsidian 导入指定的新 Markdown 文件")
    args = parser.parse_args()
    if (args.apply or args.import_new) and args.command != "sync":
        parser.error("--apply 和 --import-new 仅适用于 sync")

    root = document_root(args.docs_root)
    skill_dirs = skill_directories()
    if args.skill and args.skill not in skill_dirs:
        raise RuntimeError(f"未登记的自研 Skill：{args.skill}")
    import_new = set(args.import_new)
    for relative in import_new:
        if not managed(relative, set(skill_dirs)) or not selected(relative, args.skill):
            raise RuntimeError(f"新文档路径不在当前管理范围：{relative}")
    state = read_json(STATE_PATH)
    if state:
        if state.get("repository") != str(REPOSITORY_ROOT) or state.get("obsidianDocsRoot") != str(root):
            raise RuntimeError("同步记录绑定的仓库或 Obsidian 目录不同，已停止")
    baseline = state.get("files", {})
    if not isinstance(baseline, dict):
        raise RuntimeError("同步记录结构不合法")

    paths = (scan(REPOSITORY_ROOT, set(skill_dirs)) |
             scan(root, set(skill_dirs)) |
             set(baseline))
    paths = sorted(path for path in paths if selected(path, args.skill))
    changes = []
    conflicts = []
    updates = []
    for relative in paths:
        if not managed(relative, set(skill_dirs)):
            conflicts.append((relative, "路径不再属于已登记 Skill"))
            continue
        repository = read_document(REPOSITORY_ROOT, relative)
        obsidian = read_document(root, relative)
        action = classify(repository, obsidian, baseline.get(relative), relative in import_new)
        if action.startswith("冲突"):
            conflicts.append((relative, action))
        elif action != "一致":
            changes.append((relative, action, repository, obsidian))
        elif repository is not None and baseline.get(relative) != digest(repository):
            updates.append((relative, digest(repository)))

    for relative, action, *_ in changes:
        print(f"{action}: {relative}")
    for relative, reason in conflicts:
        print(f"{reason}: {relative}", file=sys.stderr)
    print(f"文档 {len(paths)}，待同步 {len(changes)}，冲突 {len(conflicts)}")

    if args.command == "check":
        return 1 if changes or conflicts else 0
    if conflicts:
        return 1
    if args.command != "sync" or not args.apply:
        return 0

    next_baseline = dict(baseline)
    for relative, action, repository, obsidian in changes:
        if action == "Obsidian → 仓库":
            write_document(REPOSITORY_ROOT, relative, obsidian, repository)
            next_baseline[relative] = digest(obsidian)
        else:
            write_document(root, relative, repository, obsidian)
            next_baseline[relative] = digest(repository)
        write_json_atomic(STATE_PATH, {
            "schemaVersion": 1,
            "repository": str(REPOSITORY_ROOT),
            "obsidianDocsRoot": str(root),
            "files": next_baseline,
        })
    for relative, file_hash in updates:
        next_baseline[relative] = file_hash
    if updates or not state:
        write_json_atomic(STATE_PATH, {
            "schemaVersion": 1,
            "repository": str(REPOSITORY_ROOT),
            "obsidianDocsRoot": str(root),
            "files": next_baseline,
        })
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(f"错误：{error}", file=sys.stderr)
        sys.exit(1)
